{$DOMAIN:localhost} {
    encode gzip zstd

    # API and OpenAPI docs routed to backend
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /docs* {
        reverse_proxy backend:8000
    }
    handle /openapi.json* {
        reverse_proxy backend:8000
    }

    # All frontend routes
    handle {
        reverse_proxy frontend:3000
    }
}

