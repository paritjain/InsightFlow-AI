# InsightFlow AI Platform - Environment Configuration Example

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0

# In-Memory Project Cache Configuration (LRU Eviction Limit)
PROJECT_CACHE_MAX_SIZE=50

# Optional LLM Integration (OpenAI)
# If provided, enables LLM natural language synthesis and explanations in the LangGraph agent.
# If omitted or invalid, the platform runs 100% deterministically with zero errors or downtime.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend Configuration (for Next.js / React)
NEXT_PUBLIC_API_URL=http://localhost:8000
